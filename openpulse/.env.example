# IP de la maquina donde corre Docker (laptop o PC del V305)
HOST_IP=PONER_TU_IP

# Base de datos de Nextcloud
DB_PASSWORD=cambiar

# Administrador de Nextcloud
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=cambiar

# Administrador de Collabora
COLLABORA_ADMIN=admin
COLLABORA_PASSWORD=cambiar

# Administrador de Keycloak
KC_ADMIN=admin
KC_ADMIN_PASSWORD=cambiar

# Contrasena de prueba para los usuarios de Nextcloud y Keycloak que crea setup
USERS_PASSWORD=cambiar
