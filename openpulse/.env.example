# Copiar como .env y completar. El archivo .env NO se sube a Git.
# IP de la maquina donde corre Docker (laptop o PC servidor del V305)
HOST_IP=PONER_TU_IP

# Base de datos de Nextcloud (PostgreSQL 16.4)
DB_PASSWORD=CAMBIAR

# Administrador de Nextcloud
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=CAMBIAR

# Administrador de Collabora
COLLABORA_ADMIN=admin
COLLABORA_PASSWORD=CAMBIAR

# Administrador de arranque y administrador nominal de Keycloak
KC_ADMIN=admin
KC_ADMIN_PASSWORD=CAMBIAR
KC_NOMINAL_ADMIN=wantaurco.admin

# Clave inicial de los usuarios de Nextcloud, OpenLDAP y Keycloak
USERS_PASSWORD=CAMBIAR

# Clave de las extensiones SIP 1001 a 1005 (setup genera pjsip.conf desde la plantilla)
SIP_PASSWORD=CAMBIAR

# Grafana OSS y coturn
GRAFANA_ADMIN_PASSWORD=CAMBIAR
TURN_SECRET=CAMBIAR

# Portal privado Spring Web (perfil portal; HTTPS de Caddy en :8445)
# NEXTCLOUD_PUBLIC_URL=https://IP_DEL_SERVIDOR:8443
# KEYCLOAK_PUBLIC_URL=https://IP_DEL_SERVIDOR:8444
# COLLABORA_PUBLIC_HOST=IP_DEL_SERVIDOR:9443
# GRAFANA_PUBLIC_URL=http://IP_DEL_SERVIDOR:3000
# SIP_DOMAIN=IP_DEL_SERVIDOR
# OLLAMA_MODEL=qwen2.5:0.5b

# Gemini es optativo. Usa claves autorizadas y separadas por comas.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite

# Ajusta ambos valores si la subred dedicada al proxy ya está en uso.
# OPENPULSE_PROXY_SUBNET=172.31.245.0/28
# OPENPULSE_PROXY_IP=172.31.245.14
