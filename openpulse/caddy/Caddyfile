{
	auto_https disable_redirects
	local_certs
	default_sni 192.168.35.131
}

https://192.168.35.131:8443, https://localhost:8443 {
	tls internal
	reverse_proxy nextcloud:80 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 8443
	}
}

